* ============================================================
* QMGR A — QMGRA
* ============================================================
* Upstream subscriber A.  Receives every message routed from
* PROXYQM via SUB.TO.QMGRA.  The browse connector reads
* ORDERS.INBOUND on this qmgr every 60 s and produces the
* last CorrelId to the primary Kafka cluster.
* ============================================================

* ----- Inbound queue (browse connector reads from here) -----
DEFINE QLOCAL(ORDERS.INBOUND) +
    DEFPSIST(YES) +
    REPLACE

* ----- Receiver channel (accepts messages from PROXYQM) -----
DEFINE CHANNEL(TO.QMGRA) +
    CHLTYPE(RCVR) +
    TRPTYPE(TCP) +
    REPLACE
SET CHLAUTH(TO.QMGRA) +
    TYPE(ADDRESSMAP) +
    ADDRESS('*') +
    USERSRC(CHANNEL) +
    CHCKCLNT(ASQMGR) +
    ACTION(REPLACE)

* ----- Listener -----
DEFINE LISTENER(LST.1414) +
    TRPTYPE(TCP) +
    PORT(1414) +
    REPLACE
START LISTENER(LST.1414)

* ----- SVRCONN for the browse connector -----
DEFINE CHANNEL(BROWSE.SVRCONN) +
    CHLTYPE(SVRCONN) +
    TRPTYPE(TCP) +
    MCAUSER('app') +
    REPLACE
SET CHLAUTH(BROWSE.SVRCONN) +
    TYPE(ADDRESSMAP) +
    ADDRESS('*') +
    USERSRC(CHANNEL) +
    CHCKCLNT(ASQMGR) +
    ACTION(REPLACE)
SET AUTHREC OBJTYPE(QMGR) +
    PRINCIPAL('app') +
    AUTHADD(CONNECT,INQ)
SET AUTHREC PROFILE(ORDERS.INBOUND) +
    OBJTYPE(QUEUE) +
    PRINCIPAL('app') +
    AUTHADD(BROWSE,INQ,DSP)

* ----- SVRCONN for QMGRNHA console (remote QM registration) -----
DEFINE CHANNEL(DEV.ADMIN.SVRCONN) +
    CHLTYPE(SVRCONN) +
    TRPTYPE(TCP) +
    MCAUSER('admin') +
    REPLACE
SET CHLAUTH(DEV.ADMIN.SVRCONN) +
    TYPE(ADDRESSMAP) +
    ADDRESS('*') +
    USERSRC(CHANNEL) +
    CHCKCLNT(ASQMGR) +
    ACTION(REPLACE)
SET AUTHREC OBJTYPE(QMGR) +
    PRINCIPAL('admin') +
    AUTHADD(CONNECT,INQ,DSP,ALLADM)

REFRESH SECURITY TYPE(CONNAUTH)
