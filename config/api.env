# API service environment — 3-qmgr topology
# PROXYQM: receives app PUTs via INPUT.ALIAS
PROXYQM_HOST=proxyqm
PROXYQM_PORT=1414
PROXYQM_QMGR=PROXYQM
PROXYQM_CHANNEL=PYTHON.SVRCONN
PROXYQM_USER=app
PROXYQM_PASSWORD=
ALIAS_QUEUE=INPUT.ALIAS

# QMGRA: browse connector reads from here; API reports its depth
QMGRA_HOST=qmgra
QMGRA_PORT=1414
QMGRA_QMGR=QMGRA
QMGRA_CHANNEL=BROWSE.SVRCONN
QMGRA_USER=app
QMGRA_PASSWORD=
QMGRA_QUEUE=ORDERS.INBOUND

# QMGRB: delete connector targets this; API reports its depth
QMGRB_HOST=qmgrb
QMGRB_PORT=1414
QMGRB_QMGR=QMGRB
QMGRB_CHANNEL=DELETE.SVRCONN
QMGRB_USER=app
QMGRB_PASSWORD=
QMGRB_QUEUE=ORDERS.INBOUND
