          <mxGeometry x="15" y="75" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg2t" value="IBM MQ (SRCQM / TGTQM)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="legend_bg">
          <mxGeometry x="65" y="75" width="250" height="20" as="geometry" />
