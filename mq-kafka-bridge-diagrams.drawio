          <mxGeometry x="15" y="180" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg5t" value="MirrorMaker 2 (async replication)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="legend_bg">
