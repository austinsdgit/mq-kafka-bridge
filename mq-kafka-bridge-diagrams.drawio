        <mxCell id="leg3t" value="Browse Connector (Python / pymqi)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="legend_bg">
          <mxGeometry x="65" y="110" width="250" height="20" as="geometry" />
