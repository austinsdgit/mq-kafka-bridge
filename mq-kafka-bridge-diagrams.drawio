        <mxCell id="0" /><mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="df_title" value="MQ-Kafka Bridge — Message Data Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="800" height="36" as="geometry" />
        </mxCell>

        <!-- Step labels column header -->
        <mxCell id="lbl_steps" value="Step" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="60" height="30" as="geometry" />
        </mxCell>

        <!-- ── Step 1 ── -->
        <mxCell id="s1_lbl" value="①" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1_pub" value="Publisher App&#xa;(or UI POST /messages)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="115" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s1_note" value="MQPUT → INPUT.ALIAS on SRCQM" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#57606a;" vertex="1" parent="1">
          <mxGeometry x="285" y="128" width="260" height="24" as="geometry" />
        </mxCell>

        <!-- ── Step 2 ── -->
        <mxCell id="s2_lbl" value="②" style="ellipse;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="210" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2_src" value="SRCQM&#xa;INPUT.ALIAS → ORDERS.INPUT topic&#xa;SUB.ORDERS.HA1 + SUB.ORDERS.HA2&#xa;→ REMOTE queues → XMITQ → SDR ch" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s2_note" value="Pub/sub fan-out onto two HA sender channels (CH1 port 1414, CH2 port 1415).&#xa;Both deliver to ORDERS.INBOUND on TGTQM — HA pair, not duplicate delivery." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#57606a;" vertex="1" parent="1">
          <mxGeometry x="285" y="208" width="440" height="50" as="geometry" />
        </mxCell>

        <!-- ── Step 3 ── -->
        <mxCell id="s3_lbl" value="③" style="ellipse;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="315" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s3_tgt" value="TGTQM&#xa;ORDERS.INBOUND&#xa;(messages accumulate)" style="shape=mxgraph.ibm.queue;fillColor=#f0a30a;strokeColor=#6c6c6c;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="100" y="305" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3_note" value="Messages land on ORDERS.INBOUND via receiver channels FROM.SRCQM.CH1 / CH2.&#xa;SVRCONN PYTHON.SVRCONN available for browse and delete connectors." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#57606a;" vertex="1" parent="1">
          <mxGeometry x="285" y="313" width="440" height="50" as="geometry" />
        </mxCell>

        <!-- ── Step 4 ── -->
        <mxCell id="s4_lbl" value="④" style="ellipse;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="415" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s4_browse" value="Browse Connector&#xa;consume_and_publish()&#xa;every BROWSE_INTERVAL_SECONDS" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="408" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s4_note" value="Destructively GETs ALL messages from ORDERS.INBOUND with MQOO_INPUT_EXCLUSIVE.&#xa;For each message: extracts CorrelId + MsgId, produces 1 Kafka event to mq.orders.consumed.&#xa;key = CorrelId hex · value = JSON {queue, qmgr, correl_id, msg_id, timestamp_utc}" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#57606a;" vertex="1" parent="1">
          <mxGeometry x="285" y="408" width="500" height="55" as="geometry" />
        </mxCell>

        <!-- ── Step 5 ── -->
        <mxCell id="s5_lbl" value="⑤" style="ellipse;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="515" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s5_kp" value="PRIMARY Kafka&#xa;topic: mq.orders.consumed&#xa;acks=all · idempotent producer" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="508" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s5_note" value="Each Kafka record carries the CorrelId of one consumed MQ message.&#xa;Topic retained 24 h. Partition key = CorrelId ensures ordering per message." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#57606a;" vertex="1" parent="1">
          <mxGeometry x="285" y="516" width="440" height="40" as="geometry" />
        </mxCell>

        <!-- ── Step 6 ── -->
        <mxCell id="s6_lbl" value="⑥" style="ellipse;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="610" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s6_mm2" value="MirrorMaker 2&#xa;IdentityReplicationPolicy&#xa;primary→secondary" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="603" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s6_note" value="Asynchronously replicates mq.orders.consumed to the secondary cluster.&#xa;Also syncs consumer group offsets for mq-delete-connector every 10 s (failover support)." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#57606a;" vertex="1" parent="1">
          <mxGeometry x="285" y="611" width="440" height="40" as="geometry" />
        </mxCell>

        <!-- ── Step 7 ── -->
        <mxCell id="s7_lbl" value="⑦" style="ellipse;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="705" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s7_ks" value="SECONDARY Kafka&#xa;topic: mq.orders.consumed&#xa;(replicated)" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="698" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s7_note" value="Delete connector reads from here — isolation from the primary cluster." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#57606a;" vertex="1" parent="1">
          <mxGeometry x="285" y="713" width="400" height="24" as="geometry" />
        </mxCell>

        <!-- ── Step 8 ── -->
        <mxCell id="s8_lbl" value="⑧" style="ellipse;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="800" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s8_delete" value="Delete Connector&#xa;delete_by_correl_id()&#xa;MQOO_INPUT_EXCLUSIVE&#xa;MQMO_MATCH_CORREL_ID" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="793" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s8_note" value="Polls throttle API every 10 s — pauses if enabled=false, sleeps 60/rate_per_min between cycles.&#xa;Connects to TGTQM ORDERS.INBOUND, issues MQGET with MQMO_MATCH_CORREL_ID.&#xa;Offset committed ONLY after MQ GET succeeds → at-least-once delete semantics.&#xa;Posts DELETE event to API SSE bus on success." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#57606a;" vertex="1" parent="1">
          <mxGeometry x="285" y="800" width="500" height="65" as="geometry" />
        </mxCell>

        <!-- ── Step 9 ── -->
        <mxCell id="s9_lbl" value="⑨" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="915" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s9_api" value="FastAPI SSE Bus&#xa;GET /events/delete" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="908" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s9_note" value="Each browser tab that has connected to GET /events/delete receives the delete event&#xa;in real-time via the asyncio.Queue fanout. keepalive pings sent every 15 s." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#57606a;" vertex="1" parent="1">
          <mxGeometry x="285" y="916" width="440" height="40" as="geometry" />
        </mxCell>

        <!-- ── Vertical connector line ── -->
        <mxCell id="flow_line" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1f2328;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s1_pub" target="s2_src" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1f2328;strokeWidth=2;" edge="1" source="s2_src" target="s3_tgt" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1f2328;strokeWidth=2;" edge="1" source="s3_tgt" target="s4_browse" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1f2328;strokeWidth=2;" edge="1" source="s4_browse" target="s5_kp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1f2328;strokeWidth=2;" edge="1" source="s5_kp" target="s6_mm2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1f2328;strokeWidth=2;" edge="1" source="s6_mm2" target="s7_ks" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1f2328;strokeWidth=2;" edge="1" source="s7_ks" target="s8_delete" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1f2328;strokeWidth=2;" edge="1" source="s8_delete" target="s9_api" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ── Legend ── -->
        <mxCell id="legend_bg" value="Legend" style="swimlane;startSize=24;fillColor=#f7f8fa;strokeColor=#e5e7eb;fontStyle=1;fontSize=11;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="340" height="260" as="geometry" />
        </mxCell>
