        </mxCell>
        <mxCell id="leg4t" value="Kafka (Primary + Secondary clusters)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="legend_bg">
          <mxGeometry x="65" y="145" width="250" height="20" as="geometry" />
